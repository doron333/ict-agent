# ---------- shared (crypto team + NQ) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATA_DIR=                      # auto: /data when a Railway volume is mounted
ACCOUNT_SIZE=10000
RISK_PCT=1.0
DAILY_STOP_R=3
MAX_OPEN=3
MACRO_MODE=warn                # warn | veto | off
ANTHROPIC_API_KEY=             # unset = review agent off

# ---------- crypto team ----------
PRODUCTS=ETH-USD,BTC-USD
SIGNAL_TFS=1m,5m,15m,1h,6h,1d
MIN_GRADE=B

# ---------- NQ agent ----------
NQ_ENABLED=1                   # run the NQ agent inside the main worker (recommended)
DATABENTO_API_KEY=             # required for NQ_FEED=live|poll
NQ_SYMBOL=NQ.c.0               # or MNQ.c.0
NQ_DATASET=GLBX.MDP3
NQ_MODE=paper                  # alert | paper  (no execution — alert-only policy)
NQ_FEED=live                   # live (trades → 1m bars) | poll (delayed ohlcv-1m) | csv
NQ_CSV=                        # CSV replay file for NQ_FEED=csv / backtests
NQ_BACKFILL_DAYS=6
NQ_WINDOWS=03:00-04:00,10:00-11:00,14:00-15:00   # ET; Silver Bullet windows
NQ_PD_SOURCE=rth               # PDH/PDL from prior rth (09:30-16:00) | globex session
NQ_NEWS_BEFORE_MIN=15
NQ_NEWS_AFTER_MIN=15
NQ_NEWS_EXTRA=                 # "2026-09-04 08:30 NFP;2026-09-16 14:00 FOMC" (ET)
NQ_MIN_GRADE=B
NQ_MAX_PER_DAY=3
NQ_MAX_OPEN=1
NQ_ACCOUNT_SIZE=               # defaults to ACCOUNT_SIZE
NQ_RISK_PCT=                   # defaults to RISK_PCT
# detector thresholds (tune from `nq stats` / backtest evidence — see nq_agent/config.py)
NQ_SWEEP_MIN_TICKS=2
NQ_RECLAIM_BARS=3
NQ_MSS_LEN=3
NQ_MSS_WINDOW=20
NQ_DISP_MULT=1.2
NQ_MIN_FVG_PTS=2.0
NQ_STOP_BUF_PTS=2.0
NQ_MAX_STOP_PTS=60
NQ_MIN_RR=2.0
NQ_FIXED_RR=2.0
NQ_TP_MODE=NEXT_LIQ
NQ_EXPIRY_BARS=30
